# Copy to .env.local (which is gitignored) and fill in.
# See lib/supabase/README.md for how to get these values.
#
# This build shares the full product's Supabase project (deliberate — see
# the migration comment in supabase/migrations/0021). Only two tables are
# ever touched: waitlist and survey_responses.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never prefix this with NEXT_PUBLIC_, never import it from
# anything a Client Component can reach.
SUPABASE_SERVICE_ROLE_KEY=

# The real production domain (no trailing slash) — used for metadata, Open
# Graph tags, and the sitemap (app/layout.tsx, app/sitemap.ts, app/robots.ts).
# Falls back to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=
