# Copy to .env.local (which is gitignored) and fill in once Supabase exists.
# See lib/supabase/README.md for how to get these values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never prefix this with NEXT_PUBLIC_, never import it from
# anything a Client Component can reach.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated allowlist for /admin/** — see lib/admin.ts.
ADMIN_EMAILS=

# Mapbox — must be a public token (starts "pk."), not a secret one: this
# gets bundled into client-side JS. Get one at account.mapbox.com (free tier).
NEXT_PUBLIC_MAPBOX_TOKEN=

# The real production domain (no trailing slash) — used for metadata,
# Open Graph tags, and the sitemap (app/layout.tsx, app/sitemap.ts,
# app/robots.ts). Falls back to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=
