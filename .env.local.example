# Copy to .env.local (which is gitignored) and fill in once Supabase exists.
# See lib/supabase/README.md for how to get these values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never prefix this with NEXT_PUBLIC_, never import it from
# anything a Client Component can reach.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=

# Comma-separated allowlist for /admin/** — see lib/admin.ts.
ADMIN_EMAILS=

# Mapbox — build step 10. Get a token at account.mapbox.com (free tier).
NEXT_PUBLIC_MAPBOX_TOKEN=

# PostHog — build step 12. Get a key at posthog.com (free tier).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
